# ─── Django ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Base de données ─────────────────────────────────────────────────
# Développement : SQLite (par défaut)
# Production    : décommenter la ligne PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/eduguinee

# ─── Redis / Celery ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Stockage S3 / MinIO ─────────────────────────────────────────────
USE_S3=False
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=eduguinee

# ─── SMS – Africastalking ─────────────────────────────────────────────
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=changeme

# ─── Email – Sendgrid ────────────────────────────────────────────────
SENDGRID_API_KEY=changeme

# ─── Push – Firebase ─────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-adminsdk.json

# ─── Mobile Money ────────────────────────────────────────────────────
ORANGE_MONEY_API_KEY=changeme
ORANGE_MONEY_SECRET=changeme
MTN_MOMO_API_KEY=changeme
MTN_MOMO_SECRET=changeme

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
